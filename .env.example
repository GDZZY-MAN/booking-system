POSTGRES_PASSWORD=replace-with-a-long-random-password
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
COOKIE_SECURE=false
# Optional: configure the first platform administrator. No public administrator registration exists.
PLATFORM_ADMIN_USERNAME=
PLATFORM_ADMIN_PASSWORD=
# For compose.https.yml, set PUBLIC_HOST to the certificate's public IP or DNS name.
PUBLIC_HOST=
ACME_WEBROOT=/var/www/youyue-acme
TLS_CERT_DIR=/etc/letsencrypt
